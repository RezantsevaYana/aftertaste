# Docker
DOCKER_NAME=aftertaste
APP_DOCKER_PORT=8080
BACKEND_DOCKER_PORT=3000
DOCKER_POSTGRES_PORT=5433
DOCKER_ADMINER_PORT=8081
DOCKER_MAILPIT_SMTP_PORT=1026
DOCKER_MAILPIT_UI_PORT=8026

# Postgres
POSTGRES_DB=aftertaste
POSTGRES_USER=aftertaste
POSTGRES_PASSWORD=aftertaste-local

# App
FRONTEND_ORIGIN=http://localhost:${APP_DOCKER_PORT}
PUBLIC_APP_URL=http://localhost:${APP_DOCKER_PORT}
COOKIE_SECURE=false

# SMTP (по умолчанию локальный mailpit из compose)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM="Aftertaste <no-reply@aftertaste.local>"
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
