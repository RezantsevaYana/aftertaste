  "narrative": {
    "northStar": "Культурный дневник",
    "overview": "Культурный дневник с тёплым, тактильным характером личной коллекции стал сдержаннее и взрослее. Белая галерейная основа, глубокое вино и печатная краска оставляют главным изображение, название и личную оценку. Ретро-настроение задают небольшой объёмный винил и рисованная абстракция, а не декоративная фактура всей страницы.\n\nЭто рабочий интерфейс коллекции: найти запись, вспомнить впечатление, открыть детали или добавить новое. Onest выбран для текущей итерации; прежняя оливковая палитра и наклонённые карточки не входят в эту систему.",
    "keyCharacteristics": [
      "Личная культурная коллекция с ясной иерархией.",
      "Белая основа, глубокое вино и графит.",
      "Тонкая обводка карточек без теней и наклонов.",
      "Маленький объёмный винил и авторская абстракция."
    ],
    "rules": [
      {
        "name": "The Collection Rule",
        "body": "Винный выделяет бренд, действие и оценку; изображения и личное содержание остаются главным.",
        "section": "colors"
      },
      {
        "name": "The Quiet Card Rule",
        "body": "Карточки отделяются тонкой обводкой; тени и наклоны не заменяют её.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do использовать Onest и нейтральную светлую основу текущей итерации.",
      "Do отдавать приоритет главному пользовательскому фото перед иллюстрацией категории.",
      "Do сохранять клавиатурный фокус, доступные подписи и уменьшение движения.",
      "Do хранить полный отзыв и остальные фотографии в деталях записи."
    ],
    "donts": [
      "Don't возвращать оливковые акценты и тяжёлый декоративный фон.",
      "Don't добавлять карточкам тени, наклоны или повтор названия внутри заглушки.",
      "Don't превращать многокатегорийный дневник в музыкальный сервис или маркетинговую посадочную страницу.",
      "Don't добавлять декоративные надзаголовки; категория в деталях уже указана в метаданных."
    ]
  }
